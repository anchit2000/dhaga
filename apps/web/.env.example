# Copy to .env.local in this directory (never commit real values).

# Canonical public site URL — the base for absolute URLs in metadata, the
# sitemap, robots.txt, JSON-LD, llms.txt, and blog share links. Set this to your
# deployment's public origin; defaults to the production deployment when unset.
NEXT_PUBLIC_SITE_URL=https://dhaga-web.vercel.app

# Cloud AI (server-only — never expose to the client bundle).
# Optional: without it, capture falls back to the no-LLM heuristic parser.
# Anthropic remains the default for backward compatibility. OpenAI-compatible
# servers usually require model names that exist on that server.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_EXTRACT_MODEL=gpt-4.1-mini
OPENAI_REASON_MODEL=gpt-4.1
# Contact text policy: auto uses the selected LLM with heuristic fallback;
# heuristic guarantees a zero-cost, offline-only parse.
CONTACT_PARSE_STRATEGY=auto

# Auth (better-auth). BETTER_AUTH_SECRET: any long random string
# (`openssl rand -base64 32`). BETTER_AUTH_URL: this deployment's base URL —
# ONE canonical origin (it also builds email links + OAuth callbacks).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Additional origins allowed on sign-in/sign-up (the CSRF / origin check).
# BETTER_AUTH_URL is always trusted; add extras here as a comma-separated list
# to avoid "INVALID_ORIGIN". Exact origins or wildcard patterns both work:
#   BETTER_AUTH_TRUSTED_ORIGINS=https://dhaga.app,https://www.dhaga.app
#   BETTER_AUTH_TRUSTED_ORIGINS=https://www.dhaga.app,https://dhaga-*-dhaga.vercel.app
# Prefer a PROJECT-scoped preview wildcard (dhaga-*-dhaga.vercel.app) over a bare
# *.vercel.app, which would trust every app on vercel.app. Vercel preview
# deployments are also trusted automatically (VERCEL_URL) — see
# src/lib/auth/config/trusted-origins.ts — so a wildcard is usually unneeded.
BETTER_AUTH_TRUSTED_ORIGINS=

# Social sign-in (all optional — each provider's buttons only appear once
# both its vars are set). NEXT_PUBLIC_GOOGLE_CLIENT_ID also enables Google
# One Tap on the login page (client id is public by design; the secret isn't).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Calendar integration (optional — connect Google/Microsoft to suggest open
# meeting times and flag overloaded days; read-only free/busy, never written).
# Reuses the GOOGLE_/MICROSOFT_ client ids above, but the OAuth app must also
# register the calendar redirect URIs and request calendar scopes:
#   Google:    https://<BETTER_AUTH_URL>/api/calendar/callback/google  (scope calendar.freebusy)
#   Microsoft: https://<BETTER_AUTH_URL>/api/calendar/callback/microsoft (scope Calendars.Read)
# CALENDAR_TOKEN_SECRET encrypts stored OAuth tokens at rest (any long random
# string; falls back to BETTER_AUTH_SECRET when unset).
CALENDAR_TOKEN_SECRET=
# DHAGA_CALENDAR_DEMO exposes a synthetic "Demo Calendar" you can connect with
# no real OAuth app (on by default; set to false to hide it in production).
DHAGA_CALENDAR_DEMO=true

# SMS (optional — phone number sign-in/2FA via Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email (optional — access-request confirmations + session digests via Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL="dhaga <noreply@yourdomain.com>"
DHAGA_OWNER_EMAIL=   # where YOUR digests + morning reminders get sent

# Hosted Postgres (Neon/Supabase/self-hosted). When set, the app uses it
# instead of the embedded local database — REQUIRED on serverless hosts
# (Vercel). The database must allow CREATE EXTENSION vector (pgvector).
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Connection-pool tuning (hosted mode only; see apps/web/src/utils/constants/db.ts
# and docs/SCALING.md §2). Supabase's session pooler shares a FIXED pool_size
# of 15 backends across ALL warm Vercel instances, so per-instance draw =
# DB_POOL_MAX_CORE (core pool) + DB_POOL_MAX_TENANT (EE tenant pool). Keep the
# sum small enough that several warm instances still fit under 15 (defaults
# 2 + 3 = 5/instance). Raising pool_size in Supabase is the durable capacity
# lever if slots run out under load.
# DB_POOL_MAX_CORE=2
# DB_POOL_MAX_TENANT=3
# When warm instances briefly overshoot the shared 15, the pooler rejects a new
# backend (EMAXCONNSESSION / "max clients reached", or a connect timeout) — a
# slot frees within ms, so acquisition retries with exponential backoff + jitter
# rather than 500ing. Tune the retry (both pools read these):
# DB_CONNECT_RETRY_MAX=5        # max acquisition attempts incl. the first
# DB_CONNECT_RETRY_BASE_MS=100  # first backoff step in ms (doubles each retry)

# Telegram bot (optional — capture/query from chat, ideas.md #6).
# Create a bot with @BotFather, then register the webhook:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#     -d "url=https://your-domain/api/telegram" -d "secret_token=<SECRET>"
# Your chat id: message the bot, then check getUpdates once.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Messaging (WhatsApp/Telegram inbound capture) — forward a contact card, note,
# or voice note to a bot; reply DONE (or let it auto-save when idle) and a
# positional batch processor files the contacts with a receipt per message.
# Core/AGPL, no packages/ee. One bot/number per deployment; each user links
# their chat with a token from Settings → Messaging (a self-host single owner
# falls back to DHAGA_OWNER_EMAIL above). Full setup + webhook registration:
# docs/SELF_HOSTING.md "Messaging capture". Register these webhook URLs:
#   WhatsApp: https://your-domain/api/messaging/whatsapp/webhook
#   Telegram: https://your-domain/api/messaging/telegram/webhook
#
# WhatsApp (Meta Cloud API). WHATSAPP_VERIFY_TOKEN answers Meta's GET verify
# handshake; WHATSAPP_APP_SECRET verifies inbound POST signatures (both webhooks
# fail closed when their secret is unset).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0   # optional — Meta Graph API version (default v21.0)
WHATSAPP_BUSINESS_NUMBER=      # optional — display only (the number users message)
# Telegram reuses TELEGRAM_BOT_TOKEN + TELEGRAM_WEBHOOK_SECRET from the bot block
# above; the messaging webhook verifies the same secret.
TELEGRAM_BOT_USERNAME=         # optional — display only (the @handle users message)
# Idle auto-flush window in minutes (default 15). The flush always runs on the
# daily cron (/api/jobs/daily); for ~15-min flushing add a Vercel-Pro or system
# cron hitting POST /api/jobs/messaging/flush with the CRON_SECRET bearer. Never
# add a sub-daily entry to vercel.json — it breaks Vercel Hobby's one-cron limit.
DHAGA_MESSAGING_IDLE_MINUTES=15
# Server-side voice-note transcription gateway. NO provider ships yet, so voice
# notes are stored "received, not transcribed" until one is registered.
TRANSCRIPTION_PROVIDER=

# Web search for job-change detection + the news watchlist (optional, BRD
# §6.7). Provider-agnostic gateway (see CLAUDE.md "Search gateway pattern") —
# Firecrawl is the default because it's billed per search, not per model
# call. Star a contact's "Watch for job changes & news" toggle to opt it in;
# a cron hits /api/jobs/detect-signals to run the sweep (CRON_SECRET below).
SEARCH_PROVIDER=firecrawl
FIRECRAWL_API_KEY=

# Geocoding for the map view — turns a contact's free-text location
# ("Bengaluru") into map coordinates. Provider-agnostic gateway; the default
# is Nominatim/OpenStreetMap, which needs NO API KEY and works out of the box.
# Each distinct place is geocoded ONCE and cached in the geocode_cache table —
# required, not an optimisation: Nominatim's usage policy allows a maximum of
# 1 request/second and forbids bulk querying (the client enforces the 1/s
# ceiling itself). Anything showing these coordinates must credit
# "© OpenStreetMap contributors" (ODbL).
GEOCODING_PROVIDER=nominatim
# Point at your OWN Nominatim instance to lift the public rate limit (and keep
# your contacts' places off a third-party service). Default:
# https://nominatim.openstreetmap.org
# NOMINATIM_URL=https://nominatim.example.com
# Nominatim REFUSES requests without an identifying User-Agent. Set this to
# something that names your deployment when using the public instance.
# NOMINATIM_USER_AGENT=YourApp/1.0 (+https://your-domain)

# Cron auth for /api/jobs/daily (once-a-day work: signal detection, the
# reach-out digest, the confirmations digest, the opt-in morning follow-up
# reminder, the due-follow-up sweep, the birthday/anniversary reminder, and the
# LinkedIn-export nudges — one endpoint so Vercel Hobby's single-cron limit
# fits). Vercel Cron sends this automatically
# once set (see apps/web/vercel.json); OFF Vercel, point any scheduler at the
# same URL with the same header — e.g. scripts/run-daily-jobs.sh, or directly:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://your-domain/api/jobs/daily
# Unset = the route always rejects (fails closed, never runs unauthenticated).
CRON_SECRET=

# Email-job timezone accuracy (optional). The morning reminder, reach-out digest
# and confirmations digest target ~08:00 in the recipient's LOCAL time (the IANA
# zone they picked in Settings, default UTC), but true per-timezone delivery needs
# the endpoint hit HOURLY. On Vercel Hobby's single daily cron, leave this UNSET:
# the one run always sends, at whatever UTC hour that cron fires, and a per-user
# local-day record is what stops duplicates. If you add an hourly scheduler (a
# non-Hobby cron, GitHub Actions, a container timer), set this to "true" and each
# job only sends on the run matching the recipient's local morning.
# EMAIL_JOBS_HOURLY=true
# MORNING_REMINDER_HOURLY is the old name for the same switch — still honoured
# for one release, but it now gates all three jobs, not just the morning
# reminder. Prefer EMAIL_JOBS_HOURLY.
# MORNING_REMINDER_HOURLY=true

# Outbound webhooks (optional — Zapier/automation). One URL receives
# {event, at, data} for contact.created and followup.created.
DHAGA_WEBHOOK_URL=

# Blog comments + reactions (optional — powered by giscus / GitHub Discussions).
# All four IDs are required for the comment section to render; without them it's
# simply hidden. Setup: enable Discussions on the repo, install the giscus app
# (github.com/apps/giscus), then copy the repo/category IDs from giscus.app.
# These are NEXT_PUBLIC_ (public by design — the IDs are not secrets).
# NEXT_PUBLIC_GISCUS_THEME is any giscus theme name (default: dark_dimmed).
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
NEXT_PUBLIC_GISCUS_THEME=dark_dimmed

# Non-browser clients (browser extension, future mobile app/scripts) call
# /api/* with an `x-api-key` header — create one per account from
# /app/settings once signed in (replaces the old single shared API token).

# Optional overrides:
# DHAGA_AI_MONTHLY_CAP=500     # cloud AI CREDITS per month, charged per user-visible action not per model call (a seed, not an override: it sets the instance-wide default only while nothing is set in the DB — any number an admin sets at /app/admin/ai-credits wins, and with nothing set anywhere the default is 10)
# DHAGA_DATA_DIR=/var/lib/dhaga  # where the embedded DB lives (default .dhaga-data)
# DHAGA_EMBEDDINGS=off         # disable local semantic indexing

# Dhaga Cloud only (multi-tenancy, early access, admin panel, billing) — not
# needed for self-hosting. See packages/ee/.env.example and SELF_HOSTING.md.
