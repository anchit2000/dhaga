# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright screenshot output (browsers installed via `npm run screenshot:install`)
/.screenshots/
/test-results/
/playwright-report/

# playwright E2E: saved auth session (contains cookies — never commit)
/e2e/.auth/

# next.js
/.next/
/out/

# fumadocs-mdx generated bundle (regenerated by the `postinstall`/`build` step)
/.source/

# MapLibre worker, copied out of node_modules by the `dev`/`build` step
# (scripts/copy-maplibre-worker.mjs) — vendor output, never edited by hand
/public/maplibre/

# embedded local database (PGlite)
/.dhaga-data/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
