# Dhaga Cloud only — see LICENSE. Self-hosted instances don't need any of
# this; leave DHAGA_HOSTED_MODE unset and none of it is ever read.

# Turns on early-access gating, the admin panel, and Stripe billing. All
# three read/write real Postgres (RLS) — DATABASE_URL (in apps/web/.env)
# must point at a real Postgres instance, not the embedded PGlite default.
DHAGA_HOSTED_MODE=true

# Bootstrap admin escape hatch — comma-separated emails treated as admin
# before anyone has flipped the isAdmin flag through the (not yet built)
# UI for it.
DHAGA_ADMIN_EMAILS=

# Stripe (test mode keys while developing: https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from the Stripe Dashboard — Products.
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_LIFETIME=

# Razorpay (INR) — optional, independent of Stripe. Setting BOTH keys turns on
# an "Pay in INR" button in /app/settings alongside (or instead of) Stripe's.
# Test keys: https://dashboard.razorpay.com/app/website-app-settings/api-keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# No NEXT_PUBLIC_ mirror is needed: /api/razorpay/order returns the publishable
# key id with the order, so the browser gets it from the same source of truth
# the order was created with and the two can never drift apart.
# Prices in PAISE (₹1 = 100 paise), minimum 100. There is no INR price anywhere
# in the repo — every constant is USD — so these are set per-instance rather
# than derived from an exchange rate that would silently go stale.
# e.g. 800000 = ₹8,000
RAZORPAY_PRICE_PRO_INR=
RAZORPAY_PRICE_LIFETIME_INR=

# Connection-pool tuning (read from the same apps/web env core reads — this
# file is just a documentation copy). The EE tenant pool draws from Supabase's
# fixed session pool_size of 15 shared across all warm instances; see
# apps/web/.env.example and docs/SCALING.md §2 for the full 15-slot math.
# DB_POOL_MAX_TENANT=3           # EE tenant pool max (core pool: DB_POOL_MAX_CORE, default 2)
# When the pooler transiently rejects a new backend (EMAXCONNSESSION / "max
# clients reached" / connect timeout), acquisition retries with backoff+jitter
# (packages/ee/src/db/connect-retry.ts). Raising Supabase's pool_size is the
# durable capacity lever. Tune the retry (shared with the core pool):
# DB_CONNECT_RETRY_MAX=5         # max acquisition attempts incl. the first
# DB_CONNECT_RETRY_BASE_MS=100   # first backoff step in ms (doubles each retry)
